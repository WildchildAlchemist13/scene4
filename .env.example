# ──────────────────────────────────────────────────────────────
# Scene4 — Environment Variables
# Copy to .env.local for local dev; configure these in Vercel Project Settings for production.
# ──────────────────────────────────────────────────────────────

# ── Supabase (public, used by the frontend) ───────────────────
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# ── Supabase (server-side, used by /api routes) ───────────────
# Service role key bypasses RLS. NEVER expose to the frontend or commit to git.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# ── Resend (transactional email) ──────────────────────────────
RESEND_API_KEY="re_YOUR_API_KEY"
RESEND_FROM="Scene4 <deliver@scene4.tech>"

# ── Lemon Squeezy (payments + webhook) ────────────────────────
# Set in LS dashboard → Settings → Webhooks. Any random string works for signing.
LEMON_SQUEEZY_WEBHOOK_SECRET="YOUR_RANDOM_WEBHOOK_SECRET"

# Variant IDs from LS dashboard → Products → [Product] → Variants → "..." → Get ID.
# Used as a fallback when custom_data isn't on the webhook payload.
LS_VARIANT_916_STORYTELLER=""
LS_VARIANT_GRAB_AND_KEEP=""
LS_VARIANT_STORY_MASTERY=""
LS_VARIANT_CREATOR_BUNDLE=""
LS_VARIANT_MASTER_COLLECTION=""

# ── Lemon Squeezy buy URLs (public, used by Checkout.tsx) ─────
# Get from LS dashboard → Products → [Product] → Share → "Buy link".
# Format: https://YOUR-STORE.lemonsqueezy.com/buy/VARIANT_UUID
VITE_LS_BUY_916_STORYTELLER=""
VITE_LS_BUY_GRAB_AND_KEEP=""
VITE_LS_BUY_STORY_MASTERY=""
VITE_LS_BUY_CREATOR_BUNDLE=""
VITE_LS_BUY_MASTER_COLLECTION=""
